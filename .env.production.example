# ==============================================================================
# MADHAV NETRALAYA EYE HOSPITAL - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to .env on your production server.
# NEVER commit production credentials or API keys to public repositories.
# ==============================================================================

# --- Application Setup ---
APP_NAME="Madhav Netralaya"
APP_ENV=production
APP_KEY=YOUR_32_CHARACTER_BASE64_APP_KEY_GENERATE_WITH_ARTISAN
APP_DEBUG=false
APP_TIMEZONE="Asia/Kolkata"
APP_URL=https://www.madhavnetralaya.org

# --- Logging Configuration ---
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- SQLite Production Database ---
# For VPS / Dedicated Servers: Use absolute path (e.g. /var/www/madhavnetralaya/database.db)
# For Shared Hosting: Use relative path (e.g. database.db or /home/username/core/database.db)
DB_CONNECTION=sqlite
DB_DATABASE=YOUR_DATABASE_PATH

# --- Session & Filesystem Settings ---
FILESYSTEM_DISK=public
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# --- Production Mail / SMTP Server Configuration ---
# Options: Brevo, SendGrid, Amazon SES, Google Workspace, Zoho Mail, Postmark
MAIL_MAILER=smtp
MAIL_HOST=mail.madhavnetralaya.org
MAIL_PORT=587
MAIL_USERNAME=no-reply@madhavnetralaya.org
MAIL_PASSWORD=YOUR_SMTP_PASSWORD_HERE
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@madhavnetralaya.org"
MAIL_FROM_NAME="${APP_NAME}"

# --- Gemini AI Assistant (Server-Side Ophthalmic Clinical Q&A) ---
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Instagram Graph API (Dynamic Social Wall / Post Feed) ---
INSTAGRAM_ACCESS_TOKEN="YOUR_INSTAGRAM_GRAPH_API_ACCESS_TOKEN"

# --- Razorpay Online Payment Gateway (EMD / Tender Processing) ---
VITE_RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# --- Cache & Queue Drivers ---
CACHE_STORE=file
QUEUE_CONNECTION=sync
